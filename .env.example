# 复制为 job-bot.env（比如 /etc/job-bot/job-bot.env），权限建议 chmod 600，不要提交到 Git。

# 网页工作台的管理员密码（用户名固定为 admin，HTTP Basic 认证）
JOB_BOT_ADMIN_PASSWORD=change-me-to-a-long-random-password

# Telegram：从 https://my.telegram.org 获取，见 docs/TELEGRAM_SETUP.md
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# 如果你的网络需要经代理才能连上 Telegram，这里配 SOCKS5 代理；不需要则留空
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=

# PostgreSQL 连接串
DATABASE_URL=postgresql+psycopg://jobbot:change_me@127.0.0.1:5432/jobbot

# 任意 OpenAI 兼容 LLM 接口（本地 Ollama/vLLM/sglang 或云端 API 均可）
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
